{
  "name": "magppie-installation-management",
  "version": "0.1.0",
  "private": true,
  "description": "Installation planning and workforce management: scope, skill-based staffing, travel, clearances, daily execution, timesheets, monthly reconciliation, expenses and KRA reporting.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/clean-next-cache.mjs && next dev --port 3300",
    "build": "node scripts/clean-next-cache.mjs && next build",
    "start": "next start --port 3300",
    "local": "npm run build && node scripts/local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "tsx scripts/db-reset.ts",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@phosphor-icons/react": "^2.1.10",
    "next": "^15.5.28",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
