# Leave DATABASE_URL unset to use the embedded PostgreSQL (PGlite). By default it is stored outside the project
# (Windows: %LOCALAPPDATA%\magppie-installation-management\pg; elsewhere ~/.local/share/...) so cloud-synced
# folders such as OneDrive never lock its files.
# Set it to a real PostgreSQL 14+ connection string to use an external server.
# DATABASE_URL=postgres://user:password@localhost:5432/installation

# Folder for the embedded database (ignored when DATABASE_URL is set). Avoid OneDrive/Dropbox folders.
# IM_DATA_DIR=C:/data/installation-pg

# Display timezone and currency defaults (configurable per project / policy in the app).
IM_DEFAULT_TIMEZONE=Asia/Kolkata
IM_DEFAULT_CURRENCY=INR

# Photo/video evidence: private local folder (development adapter). Keep it out of OneDrive.
# IM_EVIDENCE_DIR=C:/data/installation-evidence
# Secret for short-lived upload links (set a fixed value on a server).
# IM_EVIDENCE_SECRET=change-me
# Production scheduler endpoint for shift reminders/overtime transitions (unset = disabled).
# IM_JOB_SECRET=change-me
# IM_DISABLE_JOB_RUNNER=1
